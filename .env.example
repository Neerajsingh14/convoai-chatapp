# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to GitHub.

# REQUIRED - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL - only needed for the "Continue with Google" button
# (OAuth Web client ID from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OPTIONAL - force a specific Gemini model (the default tries several automatically)
# GEMINI_MODEL=gemini-flash-latest